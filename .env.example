# Copy to .env and paste your key. Without a key the app uses the local llama.cpp server.
NEBIUS_API_KEY=
# EARFIT_MODEL=nvidia/Nemotron-3_5-Lightning
TAVILY_API_KEY=

# --- Deployment (docker compose) ---
# Hostname whose DNS A record points at the server; Caddy gets its HTTPS certificate automatically.
DOMAIN=

# --- Limits for a public site (defaults shown) ---
# EARFIT_DAILY_BUDGET_USD=2      # model spend per UTC day, all visitors together; chat pauses when it is used up
# EARFIT_SESSION_TTL_MIN=60      # idle minutes before a visitor's chat, scan and meshes are deleted
# EARFIT_MAX_SESSIONS=200        # concurrent sessions kept in memory; the longest-idle one is dropped beyond this
# EARFIT_MAX_SCAN_MB=25          # largest scan upload
